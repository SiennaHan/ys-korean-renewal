{
	"name": "speako-korean",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit && rsbuild build",
		"build-storybook": "storybook build",
		"check": "biome check",
		"check:css": "python3 scripts/css-class-check.py && python3 scripts/fixed-box-check.py",
		"dev": "rsbuild dev --port 3000",
		"format:check": "biome format",
		"format:write": "biome format --write",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"parity:activity": "npx tsx scripts/activity-parity.tsx && python3 scripts/activity-parity-diff.py && python3 scripts/fixture-data-check.py && python3 scripts/clip-data-check.py",
		"preview": "rsbuild build && rsbuild preview",
		"start": "rsbuild preview",
		"storybook": "storybook dev -p 6006",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@rsbuild/core": "^1.0.2",
		"@rsbuild/plugin-react": "^1.0.1",
		"@storybook/react": "^10.5.9",
		"@tanstack/router-plugin": "1.136.8",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^24.8.1",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@types/react-youtube": "^7.10.0",
		"storybook": "^10.5.9",
		"storybook-react-rsbuild": "^3.4.2",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-slot": "^1.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.0.12",
		"@tanstack/react-router": "1.136.8",
		"@tanstack/router-devtools": "^1.114.13",
		"aws-amplify": "^6.16.3",
		"canvas-confetti": "^1.9.4",
		"chart.js": "^4.5.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dexie": "^4.2.1",
		"framer-motion": "^12.23.24",
		"husky": "^9.1.7",
		"i18next": "^25.9.0",
		"lucide-react": "^0.479.0",
		"postcss": "^8.5.3",
		"postcss-loader": "^8.1.1",
		"react": "^18.2.0",
		"react-audio-visualize": "^1.2.0",
		"react-audio-voice-recorder": "^2.2.0",
		"react-canvas-confetti": "^2.0.7",
		"react-chartjs-2": "^5.3.1",
		"react-device-detect": "^2.2.3",
		"react-dom": "^18.2.0",
		"react-i18next": "^16.5.8",
		"react-lottie-player": "^2.1.0",
		"react-speech-recognition": "^4.0.1",
		"react-youtube": "^10.1.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.0.12",
		"tailwindcss-animate": "^1.0.7",
		"use-sound": "^5.0.0",
		"zustand": "^5.0.8"
	},
	"packageManager": "pnpm@10.25.0"
}
