import Content1 from '@/components/main/content1';
import Content2 from '@/components/main/content2';
import Content3 from '@/components/main/content3';
import Content4 from '@/components/main/content4';
import Content5 from '@/components/main/content5';
import { useTabStore } from '@/shared/store/menu-store';
import { createFileRoute } from '@tanstack/react-router'

import {House, Bookmark, UserRound, CirclePlay, LayoutGrid } from 'lucide-react'


import { motion } from 'framer-motion';
import { ClipIcon, PracticeIcon } from '@/assets/icons';

export const Route = createFileRoute('/main')({
  component: RouteComponent,
})

function RouteComponent() {

	const {tabIndex, setTabIndex} = useTabStore();

	const onTabClick = (index: number) => {
		setTabIndex(index);
	}

	const Tab = (props: {index: number, label: string}) => {

		const color = tabIndex === props.index ? '#24425F' : '#C8CCD3';

		return <div className="cursor-pointer" onClick={e=>onTabClick(props.index)}>
			<div className='flex justify-center'>
				{props.index === 0 && <House color={color}/>}
				{props.index === 1 && <PracticeIcon color={color} />}
				{props.index === 2 && <Bookmark color={color} />}
				{props.index === 3 && <ClipIcon color={color} />}
				{props.index === 4 && <UserRound color={color} />}
			</div>
			<div className="flex justify-center text-[10px] mt-[2px]" style={{ color }}>{props.label}</div>
		</div>
	}

  return <motion.div
						initial={{ opacity: 0 }}
						animate={{ opacity: 1 }}
						exit={{ opacity: 0 }}
						transition={{ duration: 1 }}
						className="h-full bg-[#f6f7f8]">
		<div className="h-full flex flex-col">
			<div className="w-full h-full flex-1 overflow-y-auto scrollbar-hide">
				{/** contents area */}
				{tabIndex === 0 && <Content1 />}
				{tabIndex === 1 && <Content2 />}
				{tabIndex === 2 && <Content3 />}
				{tabIndex === 3 && <Content4 />}
				{tabIndex === 4 && <Content5 />}
			</div>
			<div className="sticky bottom-0 w-full h-[60px] flex justify-around items-center bg-[#fff] border-1 border-[#f6f7f8]">
				{/* <Tab index={0} label={'메인'} />
				<Tab index={2} label={'학습노트'} /> */}
				<Tab index={1} label={'과정목록'} />
				<Tab index={3} label={'표현클립'} />
				{/* <Tab index={4} label={'마이페이지'} /> */}
			</div>
		</div>
	</motion.div>
}
