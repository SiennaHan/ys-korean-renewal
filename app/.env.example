# app/.env 의 본보기 — 값은 비어 있다.
#
#     cp app/.env.example app/.env
#
# rsbuild 는 PUBLIC_ 로 시작하는 것만 번들에 넣는다. 여기 있는 값은
# 전부 브라우저로 나가므로 **비밀을 넣지 마라.**

# 리뉴얼 API. 로컬에서 api/ 를 띄웠으면 그 주소다
PUBLIC_KOREAN_API_URL=http://127.0.0.1:8000

# 교재 삽화·음성이 오는 곳.
# **비어 있으면 그림과 소리가 전부 404 가 된다** — 로컬에서 그림이 깨지면 대개 이것이다
PUBLIC_RES_URL_ROOT=

# 말하기·쓰기 채점 서버
PUBLIC_SPEAK_API_URL=
PUBLIC_WRITE_API_URL=

# QR 로 들어온 사람을 보낼 곳
PUBLIC_QR_WEB_REDIRECT_URL=

# AppSync (실시간). 셋이 한 벌이다
PUBLIC_APPSYNC_ENDPOINT=
PUBLIC_APPSYNC_REGION=
PUBLIC_APPSYNC_API_KEY=
