# api/.env 의 본보기 — 값은 비어 있다. 복사해서 api/.env 로 쓴다.
#
#     cp api/.env.example api/.env
#
# 이 파일은 코드가 실제로 읽는 이름을 뽑아 만들었다(2026-08-26).
# 값이 아니라 **이름과 필수 여부**가 이 파일의 값어치다.
# 자세한 사정은 BLOCKERS.md §6-b.


# ── 1. 없으면 서버가 안 뜬다 ─────────────────────────────────
# persistence/database.py 가 이 다섯으로 접속 URL 을 만든다.
# 지금 이 파일이 없어서 DB_PORT 가 None 이 되고 int('None') 에서 죽는다 —
# 그것이 첫 실패다.
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=

# 로그인 토큰. **반드시 base64 여야 한다** — accepter/auth.py:38 이
# base64.b64decode(JWT_SECRET) 을 한다. 아무 문자열이나 넣으면 로그인이
# 500 으로 죽는다(binascii.Error: Incorrect padding). 로컬용은 이렇게 만든다:
#
#     python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
JWT_SECRET=
JWT_ALGORITHM=HS256

# uvicorn 이 붙을 자리
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8000


# ── 2. 없으면 뜨다가 죽는다 — 가짜 값이라도 넣어야 한다 ──────
# xternal/openai.py:21 이 모듈을 읽는 순간 OpenAI() 를 만든다.
# 그래서 **키가 없으면 서버 자체가 안 뜬다.** 진짜 키가 없으면
# 아무 문자열이나 넣어라 — 뜨기는 하고 /chat/* 요청만 실패한다.
#
#   고치려면: xternal/openai.py 의 client 생성을 함수 안으로 옮긴다(지연 생성).
OPENAI_API_KEY=


# ── 3. 없어도 뜬다 — 그 기능만 실패한다 ──────────────────────
# 아래는 전부 os.getenv() 라 비어 있어도 서버가 뜬다.
# 학습 흐름(로그인 · 활동 · 기록 저장)은 이것들 없이 돌아간다.

# 음성 합성. TTS_PROVIDER 기본값은 gemini
GEMINI_API_KEY=

# 발음 평가 · 비원어민 STT (api/TUTORUS_INTEGRATION.md)
TUTORUS_CLIENT_ID=
TUTORUS_CLIENT_SECRET=
TUTORUS_TOKEN_URL=
TUTORUS_KORPRON_URL=
TUTORUS_KORSTT_WS_URL=

# 리턴제로 STT
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# QR 방문 추적
QR_TRACKING_SECRET=
QR_GEOIP_URL=
QR_STORE_RAW_IP=false


# ── 4. 기본값이 있다 — 안 적어도 된다 ────────────────────────
# TTS_PROVIDER=gemini
# TTS_CONCURRENCY=10
# WORD_PREGEN_PROVIDER=openai
# LOG_LEVEL=            # debug 로 두면 SQL 이 다 찍힌다


# ── 5. .env 로 못 넣는 것 하나 ───────────────────────────────
# 구글 TTS 자격증명은 **환경변수가 아니라 파일**이다.
# xternal/gcloud.py:7 이 경로를 코드에 박아 두고 10행에서 클라이언트를
# 바로 만든다. 그래서 **이 파일이 없으면 서버가 안 뜬다.**
#
#     api/key/korean-483509-9f4249b92e75.json   ← .gitignore 대상
#
# 파일을 받거나, gcloud.py 의 클라이언트 생성을 함수 안으로 옮겨야 한다.

# ── 문의·개인정보 (2026-08-27) ───────────────────────────────────────
# 문의 글이 꽂힐 슬랙 Incoming Webhook.
# **없어도 접수는 된다** — DB 에 먼저 넣고 그다음에 보낸다. 못 보낸 것은
# notified=0 으로 남고 `tools/resend_inquiries.py` 로 다시 보낸다
# 길이 둘이다. **봇 토큰이 있으면 캡처 파일이 그대로 올라간다** —
# Incoming Webhook 은 파일을 못 올려 링크만 실을 수 있다.
#
# 봇 토큰 쪽을 쓰려면 사람이 해야 하는 일 셋:
#   1. Slack 앱을 만들고 봇 토큰 스코프 chat:write · files:write 를 준다
#   2. 그 봇을 받을 채널에 초대한다 (/invite @봇이름)
#   3. 아래 둘을 채운다. 채널 id 는 채널 주소의 마지막 토막이다
#      …/archives/C0BSL4ZUVQF  →  C0BSL4ZUVQF
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# 봇 토큰이 없을 때 쓰는 길. 글만 가고 캡처는 링크로 붙는다
SLACK_WEBHOOK_URL=
# 그 링크가 몇 초 사는지(기본 하루). 웹훅으로 떨어졌을 때만 쓴다 —
# 봇 토큰이면 파일 자체가 올라가므로 링크가 필요 없다
SLACK_LINK_TTL_SEC=86400

# ── 사내 피드백 허브 ─────────────────────────────────────────────────
# 문의를 허브로도 흘려보낸다(xternal/feedback_hub.py). 슬랙과 같은 성격이다 —
# **여기서 실패해도 문의 접수는 성공이고, 둘이 비면 조용히 안 보낸다.**
# 로컬·검사 환경에는 없어도 된다.
#
# 키는 허브의 services 표에서 발급한 svc_… 다. **쓰기 전용이라 이 키로 조회는
# 안 된다** — 노출돼도 다른 제보를 읽을 수 없다. 다만 재발급이 가능해야 하므로
# 코드에 박지 말고 여기에 둔다.
FEEDBACK_HUB_URL=https://feedback-collect.olim.freewheelin.io
FEEDBACK_HUB_SERVICE_KEY=
# 제보의 「발생 화면」에 붙는 도메인. from_path 가 경로뿐이라 앞에 붙인다
PUBLIC_SITE_ORIGIN=https://korean.pulleyai.co.kr

# 학습자 음성 보관. 전에는 코드에 True·1.0 이 박혀 **전량 보관**됐다
STT_SHADOW_ENABLED=1
STT_SHADOW_SAMPLE_RATE=0.1
# 며칠 뒤 지울지. **0(기본)이면 안 지운다** — 개인정보 처리방침에 적을 값이라
# 기획이 정하기 전에는 마음대로 지우지 않는다. 정해지면 여기 넣고
# `tools/prune_stt_shadow.py` 를 크론에 건다
STT_SHADOW_RETENTION_DAYS=0

# S3. 기본값이 pulley-mock 인 것은 지금 그 버킷을 쓰고 있어서다 —
# **운영에서는 반드시 따로 준다**
S3_BUCKET=
S3_REGION=ap-northeast-2

# 기관 학생(학교 계약)이 전 급을 받는지. 기본은 켜짐(2026-08-28 기획 확정).
# **끄면 예전 동작으로 돌아간다** — 범위는 무료와 같고 source 만 school 이라
# 앱이 「학교에 문의」를 띄운다. 이 변경은 전 학교의 전 학생에게 즉시 보이고
# 엑셀로 등록된 기존 학생에게도 적용되므로, 배포 없이 되돌릴 길을 둔 것이다.
SCHOOL_FULL_SCOPE=true
