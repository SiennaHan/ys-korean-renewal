# ── macOS ──
.DS_Store

# ── 배포판 참고본 ────────────────────────────────
# korean-master/ 는 지금 배포돼 있는 버전이다. 리뉴얼의 출발점이 아니라
# 대조용이므로 손대지 않고 저장소에도 넣지 않는다. 필요한 코드는 app/ 으로 가져온다.
korean-master/
korean-admin-master/
koreanapi-master/
writeapi-master/
*.zip

# ── 교재 파생 자산 ───────────────────────────────
# 연세 교재에서 추출·가공한 것. 라이선스 범위 밖으로 나가면 안 된다.
illust/*
# 다만 원장을 만든 빌드 스크립트는 추적한다(98개 · 792K). 이것이 없어서 v24 가
# 자모 400행을 날렸을 때 커밋 로그로 원인을 찾을 수 없었다 — 원장이 어떻게
# 지금 판이 됐는지 아는 것이 스크립트뿐인데 그게 git 밖에 있었다.
# 삽화 PNG 5040개 · 원장 xlsx · 하위 폴더는 계속 막힌다.
!illust/*.py
# 앵커(/)가 있어야 한다. book/ 이라고 쓰면 깊이 무관하게 book 이름의 모든 폴더를
# 막는다 — 그래서 app/src/routes/book/ 의 소스 19개가 통째로 빠져 있었고,
# 추적되는 routeTree.gen.ts 가 그 19개를 import 해서 받는 사람은 빌드가 안 됐다.
/book/
# 교재 삽화·음성. 소스가 아니라 자산이므로 계속 막는다(PUBLIC_RES_URL_ROOT 가 준다)
app/public/book/
*.xlsx
# 교재 부록 원본 PDF 8권. 이력에 들어간 적은 없다(195커밋 확인) — 계속 막아 둔다.
*.pdf

# 플래시카드 낱말 그림 96장 · 271M. 교재에서 뽑아 가공한 자산이라 라이선스
# 범위 밖으로 나가면 안 되고, 용량만으로도 들어가면 안 된다.
# **앵커(/)가 있어야 한다** — 위 /book/ 과 같은 사정이다. flashcard/ 라고 쓰면
# 깊이 무관하게 그 이름의 모든 폴더를 막는데, 추적 중인
# app/src/routes/book/chapter/unit/flashcard/ 가 바로 그 이름이다.
/flashcard/

# ── 참고 자산 (용량) ─────────────────────────────
# 획순 안내 PNG 187개 · 5MB. 코드가 참조하지 않는 디자인 참고물이다.
handwriting/

# ── 도구 캐시 · 임시물 ───────────────────────────
# pnpm 패키지 저장소. 산출물이라 저장소에 들어갈 것이 아니다.
# **앵커(/)를 붙인다** — 위 /book/ · /flashcard/ 와 같은 사정이다. 지금은 루트에
# 하나뿐이지만, 앵커가 없으면 나중에 어느 깊이에 같은 이름이 생겨도 통째로 막는다.
/.pnpm-store/

# 이름 그대로 지울 것들이 쌓이는 자리(파일 206개 · 1.3M). 대조 출력 덤프와 임시 CSV 다.
# 커밋 때마다 `??` 로 떠서 매번 "이건 뭐지" 를 다시 물어야 했다.
# **여기 든 것은 언제 지워도 되는 것이어야 한다** — 남길 것이 생기면 밖으로 꺼내라.
/_to_delete/

# ── 파이썬 ──
__pycache__/
*.pyc

# ── Storybook 빌드 산출물 ────────────────────────
app/storybook-static/
app/.tanstack/
